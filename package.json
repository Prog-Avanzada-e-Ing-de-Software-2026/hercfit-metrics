{
  "name": "hercfit-metrics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Automated collection and reporting of HercFit MVP process, product and project metrics.",
  "scripts": {
    "start": "tsx src/index.ts",
    "report": "tsx src/index.ts",
    "snapshot": "tsx src/index.ts --snapshot-only",
    "rules": "tsx src/rules/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "packageManager": "yarn@4.18.1"
}
