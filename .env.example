# ClickUp personal API token. Required.
CLICKUP_TOKEN=

# ClickUp workspace, space and list that hold the project board.
CLICKUP_LIST_ID=901717994296

# GitHub token able to read Pull Requests and Deployments on both project
# repositories. A classic PAT with `repo` scope or a fine-grained token with
# Pull requests: Read and Deployments: Read works.
GH_PAT=

# Optional. When both are set, the weekly report is pushed to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Path to a Vitest JSON report used for rule traceability.
VITEST_RESULTS=
